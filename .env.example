NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace_with_random_secret_at_least_32_chars
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace_with_random_secret
DATABASE_URL=postgresql://lms:change_me@localhost:5432/lms_gdsg?schema=public
DIRECT_URL=postgresql://lms:change_me@localhost:5432/lms_gdsg?schema=public
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=30
POSTGRES_DB=lms_gdsg
POSTGRES_USER=lms
POSTGRES_PASSWORD=change_me
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
OAUTH_TOKEN_ENCRYPTION_KEY=replace_with_64_hex_characters
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Quản trị viên
SEED_DEMO=false
UPLOAD_ROOT=/data/lms
RECORDINGS_DIR=/data/lms/recordings
DOCUMENTS_DIR=/data/lms/documents
SUBMISSIONS_DIR=/data/lms/submissions
